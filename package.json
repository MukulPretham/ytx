{
  "name": "ytx",
  "version": "1.0.0",
  "description": "Archive YouTube videos with their transcripts into a self-contained local library",
  "type": "module",
  "bin": {
    "ytx": "./src/main.ts"
  },
  "scripts": {
    "start": "bun run src/main.ts",
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit",
    "build": "bun build --compile src/main.ts --outfile dist/ytx"
  },
  "dependencies": {
    "@clack/prompts": "^0.11.0",
    "smol-toml": "^1.3.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bun": "^1.2.19",
    "typescript": "^5.9.2"
  }
}
